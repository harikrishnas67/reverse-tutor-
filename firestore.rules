rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth != null && request.resource.data.uid == request.auth.uid; }
    function mine() { return request.auth != null && resource.data.uid == request.auth.uid; }
    match /users/{id} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == id; }
    match /scores/{id} { allow read: if request.auth != null; allow create, update: if me(); }
    match /daily/{id} { allow read: if request.auth != null; allow create: if me(); }
    match /hack/{id} { allow read: if request.auth != null; allow create: if me(); }
    match /posts/{id} { allow read: if request.auth != null; allow create: if me(); allow delete: if mine(); }
    match /replies/{id} { allow read: if request.auth != null; allow create: if me(); }
    match /votes/{id} { allow read: if request.auth != null; allow create: if me(); allow delete: if mine(); }
  }
}
